# .gitignore

# --- Generated documentation ---
_deps/
/build/
build/
build*/
build_*/
/build_*/
build-*/
/build-*/
/build*/
/build_release/
/build_ucrt64/
/out/
/dist/
/out/
/bin/
bin/
dist/

# --- Editor temporary files ---
*~
*.swp
*.swo

# --- Generated files ---
*.log
*.tmp
*.bak
*.d
*.spv

# --- IDE and Editor Files ---
.vscode/
.idea/
*.code-workspace
compile_commands.json

# --- OS-specific garbage ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Misc ---
*.tar
*.zip
*.rar
*.gz
*.xz
*.7z
*.bin
*.dump
*.crash

# --- Kate IDE internal build cache ---
.kateproject.build

# --- Kate IDE swap files ---
*.kate-swp

# --- Python generated bytecode ---
__pycache__/
*.py[cod]
